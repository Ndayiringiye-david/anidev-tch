        <div className="absolute top-0 right-0 w-32 h-32 md:w-32 md:h-32 bg-primary-400 opacity-50 rounded-b" />
        <div className="absolute inset-0 bg-primary bg-opacity-50" />
        <div className="absolute inset-0 bg-gradient-to-r from-primary-900/70 via-primary-800/60 to-primary/50" />
        <div className="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
